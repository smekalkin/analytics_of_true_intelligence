PORT=3001
DATABASE_URL=postgres://analytics:analytics@localhost:5432/analytics
# Пусто → случайный ключ при старте (сессии сбрасываются при перезапуске). В production — минимум 32 случайных символа
JWT_SECRET=
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:3000
# Внешний геосервис (вариант Б); локально: npm run mock-geo
GEO_API_URL=http://localhost:4010
GEO_API_KEY=mock-geo-key
GEO_API_MAX_ATTEMPTS=4
GEO_API_TIMEOUT_MS=5000
