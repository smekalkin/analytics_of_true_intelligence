{
  "name": "ti-analytics-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API аналитического кабинета «Истинный интеллект»",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "migrate": "ts-node src/database/migrate.ts",
    "seed": "ts-node src/database/seed.ts",
    "seed:reset": "ts-node src/database/seed.ts --reset",
    "sync:all": "ts-node src/sync/sync-all.ts",
    "mock-geo": "ts-node src/mock-geo/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:e2e": "jest --runInBand --selectProjects e2e"
  },
  "dependencies": {
    "@nestjs/common": "11.1.9",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.9",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.1.9",
    "@nestjs/typeorm": "11.0.3",
    "bcryptjs": "2.4.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.27"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "11.1.9",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.18.6",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "supertest": "7.1.4",
    "ts-jest": "29.4.4",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": { "^.+\\.ts$": "ts-jest" },
        "moduleFileExtensions": ["js", "json", "ts"],
        "testEnvironment": "node"
      },
      {
        "displayName": "e2e",
        "rootDir": "test",
        "testRegex": ".*\\.e2e-spec\\.ts$",
        "transform": { "^.+\\.ts$": "ts-jest" },
        "moduleFileExtensions": ["js", "json", "ts"],
        "testEnvironment": "node",
        "setupFiles": ["<rootDir>/setup-env.ts"]
      }
    ]
  }
}
